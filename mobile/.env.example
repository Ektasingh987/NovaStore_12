# ==========================================
# NovaStore Mobile App Environment Variables Example
# ==========================================

# Backend API URLs
API_BASE_URL_ANDROID=http://10.0.2.2:5000
API_BASE_URL_WEB=http://localhost:5000
API_BASE_URL_DEFAULT=http://localhost:5000

# Google OAuth 2.0 Client IDs
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=your_google_server_client_id.apps.googleusercontent.com

# Application Configuration
APP_NAME=NovaStore
CURRENCY_SYMBOL=₹
FREE_DELIVERY_THRESHOLD=500
DEFAULT_DELIVERY_FEE=50
